# Copy to `.env` and fill in when the backend exists. Placeholders only — never commit secrets.
# The frontend works fully in mock mode with no env vars set.

# Base URL of the Cloudflare Worker API, e.g. https://pyq-api.<account>.workers.dev
# Leave empty to stay in mock mode (local sample data, simulated uploads).
VITE_API_BASE_URL=

# Set to "false" once VITE_API_BASE_URL points at a real API.
VITE_USE_MOCK=true

# --- Future server-side only (NOT VITE_*, never ship to the browser) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
# MODERATOR_AUTH_ISSUER=
